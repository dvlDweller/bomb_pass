# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Database (PostgreSQL / Neon) ----
DATABASE_URL=postgresql://user:password@host:5432/bomb_pass
DB_SCHEMA=bomb_pass
DB_POOL_MAX=10

# ---- Auth ----
# REQUIRED in production. Dev fallback is used only when NODE_ENV !== 'production' and this is unset.
JWT_SECRET=change-me-in-production
# Host token lifetime (Hub Contract default 8h).
HOST_TOKEN_TTL=8h
# Player token lifetime (Hub Contract: 3 hours, one session only).
PLAYER_TOKEN_TTL=3h

# ---- CORS ----
# Hub address only, e.g. https://hub.library.edu. Leave empty to disable CORS.
# Localhost is additionally allowed when NODE_ENV !== 'production'.
HUB_ORIGIN=

# ---- Game info (Hub Contract Rule 1) ----
TEAM_NAME=Bomb Pass Team
SECTION=3-2

# ---- Game rules ----
BOMB_TIMER_SECONDS=30
MAX_PLAYERS=30

# ---- Login rate limiting (database-backed) ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- Seed script (db/seed/seed.js) ----
SEED_HOST_USERNAME=librarian
SEED_HOST_PASSWORD=Librarian123!

# ---- Tests ----
# TEST_DATABASE_URL=postgresql://user:password@host:5432/bomb_pass_test
